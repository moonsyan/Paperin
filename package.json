{
  "name": "paperin",
  "version": "0.6.0",
  "description": "本地 Markdown 知识工作台：打开资料 → 用来源写一段技术说明",
  "author": "ming",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "demo:soft": "vite --config design/soft-workbench/vite.config.ts",
    "demo:soft:check": "tsc -p design/soft-workbench/tsconfig.json && eslint \"design/soft-workbench/**/*.{ts,tsx}\"",
    "demo:soft:build": "npm run demo:soft:check && vite build --config design/soft-workbench/vite.config.ts",
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{ts,mjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:ci": "vitest run --maxWorkers=1 --minWorkers=1",
    "a11y": "node scripts/theme-contrast.mjs && node scripts/focus-outline.mjs",
    "a11y:contrast": "node scripts/theme-contrast.mjs",
    "a11y:focus": "node scripts/focus-outline.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs --documents 5000 --bytes-per-doc 2048",
    "perf:large-file": "node scripts/perf-baseline.mjs --documents 1 --bytes-per-doc 5242880",
    "perf:regression": "node scripts/perf-regression.mjs",
    "perf:production": "vitest run --config vitest.performance.config.ts",
    "perf:electron": "node scripts/smoke-electron.mjs --performance",
    "perf:workspace-search-watch": "vitest run --config vitest.performance.config.ts src/main/ipc/workspace-search-watch-production.perf.ts",
    "preview": "electron-vite preview",
    "smoke": "node scripts/smoke-electron.mjs",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.paperin.app",
    "productName": "Paperin",
    "directories": {
      "output": "release/${version}",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "!out/**/*.tsbuildinfo",
      "!**/*.map"
    ],
    "afterPack": "scripts/afterPack.js",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Paperin Markdown Document",
          "description": "Markdown 文档"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Paperin-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Paperin Markdown Document",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "moonsyan",
      "repo": "Paperin",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/plugin-prism": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "katex": "^0.18.2",
    "mdast-util-footnote": "^1.1.1",
    "mdast-util-frontmatter": "^2.0.1",
    "mermaid": "^11.16.1",
    "micromark-extension-footnote": "^1.0.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "refractor": "^5.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
